{
  "name": "vendor-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npm install && npm --prefix client install",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node index.js",
    "dev": "concurrently \"node index.js\" \"npm --prefix client run dev -- --host 0.0.0.0\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}